# Copy to .env to point the examples at your own tenant.
# Both are optional: with no .env the examples run against the public demo tenant
# configured in src/config.js.

# Your Booking API key. Never commit a real one — a key in a browser bundle is public.
VITE_API_KEY=

# Only needed if your API lives somewhere other than the default host.
VITE_API_BASE_URL=https://booking-api.barberly.com
